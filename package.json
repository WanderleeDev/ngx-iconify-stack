{
  "name": "ngx-iconify-workspace",
  "version": "0.1.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ngx-iconify-stack && cd projects/ngx-iconify-stack && npm run build",
    "build:docs": "ng build docs",
    "release": "release-it",
    "release:next": "release-it --preRelease=next",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:docs": "node dist/docs/server/server.mjs",
    "ngx-theme-stack:sync": "ng generate ngx-theme-stack:sync --project docs",
    "ngx-theme-stack:skill": "ng generate ngx-theme-stack:skill --project docs",
    "prebuild": "npm run ngx-theme-stack:sync && npm run ngx-iconify-stack:generate-icons",
    "prestart": "npm run ngx-theme-stack:sync",
    "ngx-iconify-stack:generate-icons": "ng generate ngx-iconify-stack:generate-icon-subset --project docs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "express": "^5.1.0",
    "iconify-icon": "^3.0.2",
    "ngx-iconify-stack": "file:./dist/ngx-iconify-stack",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.92",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/types": "^2.0.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "copyfiles": "^2.4.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "ngx-theme-stack": "^3.9.2",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "release-it": "^18.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
