{
  "name": "ngx-iconify-stack",
  "version": "0.1.0",
  "description": "Iconify integration for Angular with hybrid SSR rendering, lazy loading and schematic tooling.",
  "author": "WanderleeDev",
  "repository": {
    "type": "git",
    "url": "https://github.com/WanderleeDev/ngx-iconify-stack.git"
  },
  "bugs": {
    "url": "https://github.com/WanderleeDev/ngx-iconify-stack/issues"
  },
  "homepage": "https://github.com/WanderleeDev/ngx-iconify-stack",
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "iconify-icon": ">=3.0.2",
    "@iconify/types": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@iconify/types": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.schematics.json",
    "postbuild": "copyfiles -u 2 \"src/schematics/*/schema.json\" src/schematics/collection.json ../../dist/ngx-iconify-stack/schematics/ && node -e \"const f='../../dist/ngx-iconify-stack/package.json',p=JSON.parse(require('fs').readFileSync(f,'utf8'));delete p.type;require('fs').writeFileSync(f,JSON.stringify(p,null,2)+'\\n');\""
  },
  "schematics": "./schematics/collection.json"
}
